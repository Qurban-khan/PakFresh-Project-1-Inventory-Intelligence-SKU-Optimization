table DimProduct
	lineageTag: 43963aca-f26f-4a92-81a5-2a00c7e05627

	measure 'Excess Inventory Flag' =
			
			IF([Stock Cover Days] > SELECTEDVALUE(DimProduct[Target Cover Days]) * 1.5, 1, 0)
		formatString: 0
		lineageTag: 519ffdbf-bd41-46d1-95b5-a0a3226a409c

	measure 'Excess Inventory Value' =
			
			SUMX(
			    VALUES(DimProduct[SKU]),
			    IF([Excess Inventory Flag] = 1, [Avg Inventory Value])
			)
		lineageTag: 472a64a8-ae26-4ec8-9a48-38bfb8f4e14f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

