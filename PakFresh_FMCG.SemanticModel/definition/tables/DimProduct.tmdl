	column XYZ = IF(DimProduct[CV]<=.6,"X",IF(DimProduct[CV]<=.74,"Y","Z"))
		lineageTag: 04b53937-cb31-4432-9acc-a5652a0d60f1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ABCXYZ = DimProduct[ABC]&DimProduct[XYZ]
		lineageTag: 13cdc7dc-663b-4af3-ad25-9e047f7312a1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Target Cover Days' =
			
			DimProduct[LeadTimeDays] +
			SWITCH(
			    DimProduct[DemandClass],
			    "Fast", 10,
			    "Medium", 14,
			    "Slow", 21,
			    "Very Slow", 30
			)
		formatString: 0
		lineageTag: 9543a08d-fbdd-4445-9a1d-cc52de4c99c4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

