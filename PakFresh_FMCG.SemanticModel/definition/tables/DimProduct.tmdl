	column 'SKU Revenue' = CALCULATE(SUM(FactSales[NetRevenue]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 8eec8d3b-5e35-40dc-9ed2-0049afa53041
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Profit Rank' = RANKX(DimProduct,DimProduct[SKU Profit],,DESC,Dense)
		formatString: 0
		lineageTag: 217c68a8-2423-4ce3-9c74-5365fc5e17c3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Cumulatative Profit' = SUMX(FILTER(ALL(DimProduct),DimProduct[Profit Rank] <= EARLIER(DimProduct[Profit Rank])), DimProduct[SKU Profit])
		formatString: #,0.0
		lineageTag: 3ed775e5-0524-44b8-9ca7-f9bd1638ed4b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Cumulative Profit %' = DIVIDE(DimProduct[Cumulatative Profit], SUMX(ALL(DimProduct),DimProduct[SKU Profit]))
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 71933878-9304-4f9b-bfdf-0926afb29ece
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ABC = IF(DimProduct[Cumulative Profit %] <=.80, "A", IF(DimProduct[Cumulative Profit %] <= .95, "B", "C"))
		lineageTag: da9ed87e-d78a-48f9-96c3-b9da6b0c2eba
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'SKU Profit' = CALCULATE(SUM(FactSales[GrossProfit]), ALL(FactSales[SKU]))
		lineageTag: 707c726f-3a91-43c5-823b-87eb20c3cb05
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Cumulative SKU %' = DimProduct[Profit Rank] / COUNTROWS(ALL(DimProduct))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3218a186-4b39-4ab5-a4b2-0df454214598
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

